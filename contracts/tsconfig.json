{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "//": "artifacts/*.d.ts are generated by `hardhat compile` and give the viem contract handles their typed read/write surface, so typecheck compiles first.",
  "include": ["./scripts", "./test", "./hardhat.config.ts", "./artifacts/**/*.d.ts"]
}
