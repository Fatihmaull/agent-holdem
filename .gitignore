# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored, because pnpm gives every workspace package a node_modules of its
# own and those are no more source than the root one.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template is meant to be cloned. Without this the readme's first
# instruction refers to a file that is not in the repository.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# foundry
/contracts/out/
/contracts/cache/
/contracts/broadcast/

# docker volumes
/.data/
field.json
