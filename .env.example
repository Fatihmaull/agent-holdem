# AgentHoldem — copy to .env and fill in.
#
#   cp .env.example .env
#   openssl rand -base64 32     # paste into SESSION_SECRET
#
# The two under "Required" are the only ones without a working default: server
# modules refuse to load without them, on purpose. Everything else has a
# default good enough to run the whole loop locally.

# ── Required ───────────────────────────────────────────────────────────────

# Matches docker-compose.yml. Change the port here too if you set POSTGRES_PORT.
DATABASE_URL=postgres://agentholdem:agentholdem@localhost:5432/agentholdem

# Signs session cookies. Generate with: openssl rand -base64 32
# A new value logs everyone out, which is the point if one ever leaks.
SESSION_SECRET=

# ── Postgres (docker compose up -d) ────────────────────────────────────────

# Only needed if 5432 is already taken on your machine. Set DATABASE_URL to match.
# POSTGRES_PORT=5432
# POSTGRES_PASSWORD=agentholdem

# ── Agents ─────────────────────────────────────────────────────────────────

# gemini | heuristic. The heuristic provider plays by the numbers already
# computed for it, so the whole loop runs with no key and no network — but it
# ignores owner instructions entirely, so it is for development, never judging.
# It refuses to start when NODE_ENV=production.
AGENT_PROVIDER=heuristic

# Comma-separated. The queue rotates them, so several keys means several
# agents thinking at once rather than one at a time.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3-flash

# Requests per minute allowed per key. Limits are enforced per project, so
# more keys on one project is not a way to multiply a free tier.
AGENT_RATE_LIMIT_RPM=10

# Raise if a model hits its output limit before writing anything.
AGENT_MAX_OUTPUT_TOKENS=2048

# Hard ceiling on model requests per rolling day, across every table and every
# account. The rate limit above bounds the speed; this bounds the bill, which
# matters because the tables play by themselves and nobody has to stay and
# watch it grow. Past the ceiling every seat falls back to check-or-fold.
# Unset means no ceiling — fine locally, not in production.
# AGENT_DAILY_REQUEST_CAP=5000

# Thinking tokens. Unset lets the model decide; 0 turns thinking off.
# GEMINI_THINKING_BUDGET=

# ── BNB Smart Chain Testnet ────────────────────────────────────────────────

NEXT_PUBLIC_CHAIN_ID=97
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Written by `pnpm deploy:vault`. Until it is set the cashier cannot take
# deposits, though tables still deal.
NEXT_PUBLIC_CHIP_VAULT_ADDRESS=

# Pays redemptions out of the vault, and deploys it. Fund it with testnet tBNB.
# This key can move real vault funds — keep it out of the browser and out of git.
TREASURY_PRIVATE_KEY=

# Owner of the deployed ChipVault. Read by scripts/deploy-vault.sh only.
VAULT_OWNER=

# `pnpm treasury` exits non-zero below this, so a scheduled check can page
# somebody while there is still time to top the vault up.
# TREASURY_MIN_BNB=0.5

# ── The deposit watcher ────────────────────────────────────────────────────
#
# Credits deposits from the chain rather than from a browser, so a player who
# pays and closes the tab still gets their chips. The defaults are fine; these
# exist for a slow RPC or an unusually strict one.

# How often to scan for new deposits.
# DEPOSIT_SWEEP_INTERVAL_MS=20000

# Blocks per getLogs call. Lower it if your RPC rejects the range.
# DEPOSIT_SCAN_CHUNK=2000

# How far back a first-ever scan looks when no pending intent says where to
# start. Only used on a fresh deployment with nothing owed.
# DEPOSIT_SEED_LOOKBACK_BLOCKS=20000

# How long an unpaid deposit request stays open before it is written off. The
# chain is asked first, so a request that was actually paid is never closed.
# DEPOSIT_INTENT_TTL_MS=86400000

# ── Operations ─────────────────────────────────────────────────────────────

# Hand the shutdown signals to us instead of to Next, so a deploy can finish
# the hand in progress rather than cutting it off mid-deal. Set this in
# production; the boot log says which mode you are in.
# NEXT_MANUAL_SIG_HANDLE=1

# How long a hand in progress is given to finish once a deploy has started.
# Set the platform's own termination grace period ABOVE this, or the container
# is killed before the drain can do anything.
# SHUTDOWN_DRAIN_MS=45000

# debug | info | warn | error. Defaults to info in production, debug otherwise.
# LOG_LEVEL=info

# json | pretty. Defaults to json in production so a collector can index it.
# LOG_FORMAT=json

# Where an error goes so a person sees it. A Slack-style incoming webhook, or
# anything that accepts a JSON post. Unset, errors only reach stdout.
# ERROR_WEBHOOK_URL=

# How long the engine may go without finishing a hand before /api/health calls
# it stalled. Only counts once a table has dealt at least one hand.
# HEALTH_STALL_AFTER_MS=600000

# ── Tests ──────────────────────────────────────────────────────────────────

# `pnpm test:db` truncates every table, so it runs against its own database.
# Unset, it derives one by appending _test to the name in DATABASE_URL.
# TEST_DATABASE_URL=

# ── Local overrides ────────────────────────────────────────────────────────

# The origin sign-in messages are bound to. Unset, it follows the request host,
# which is right for localhost and wrong behind a proxy. Pin it in production.
# APP_ORIGIN=http://localhost:3000

# Set to 1 to start the web app without the match engine, so tables sit idle.
# Useful when you want to poke at the interface without hands being dealt.
# AGENTHOLDEM_DISABLE_ENGINE=
