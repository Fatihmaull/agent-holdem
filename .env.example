# Database (docker compose up -d)
DATABASE_URL=postgres://agentholdem:agentholdem@localhost:5432/agentholdem
POSTGRES_PASSWORD=agentholdem
POSTGRES_PORT=5432

# Session signing. Generate with: openssl rand -base64 32
SESSION_SECRET=

# The origin this deployment is served from, with scheme and no trailing slash.
# Sign-in messages are bound to it, so it must not be read from the request:
# a signature collected elsewhere would otherwise verify here. Required in
# production; left blank, development falls back to the request's own host.
APP_ORIGIN=

# Chains this deployment settles on, by their key in src/lib/chains.ts, in the
# order the switcher offers them. Left unset, every chain in the registry is
# offered. DEFAULT_CHAIN picks the one a new visitor lands on; unset, it is the
# first of CHAINS.
CHAINS=bnb-testnet,arbitrum-sepolia,monad-testnet
DEFAULT_CHAIN=bnb-testnet

# Per chain, named after its key. The RPC endpoint is optional and falls back to
# the public one in the registry. The vault address is written here by
# `pnpm deploy:vault <chain-key>`; a chain without one can be watched but not
# bought into. Adding a chain is a row in src/lib/chains.ts plus a pair here.
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BNB_TESTNET_VAULT_ADDRESS=
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_VAULT_ADDRESS=
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_VAULT_ADDRESS=

# Deploys ChipVault. Only used by `pnpm deploy:vault`, never by the running
# server: chips are one-way, so there is no payout for a key to sign. Testnet
# only. Never a mainnet key.
TREASURY_PRIVATE_KEY=
# Contract deploy inputs (used by forge script)
VAULT_OWNER=
# Optional, for `forge verify-contract`. Only explorers with an Etherscan-style
# API have one.
BNB_TESTNET_EXPLORER_API_KEY=
ARBITRUM_SEPOLIA_EXPLORER_API_KEY=

# How many hands a match runs before it is called. Unset, a hundred, which is
# right for measuring and takes about eighty minutes. A public arena wants
# matches a visitor can watch reach an end; thirty is about twenty-five minutes.
# Each match stores the cap it was played under, so lowering this does not make
# a liar of any result already recorded.
HAND_CAP=

# --- The arena holds no model key -------------------------------------------
# Nothing below is read by the server. Agents are programs their owners run, so
# paying for thinking is their problem, which is what stops the arena's running
# cost scaling with the number of people playing.
#
# The reference agent in packages/agent reads these instead:
#   ARENA_URL=wss://<host>/agent   where to connect
#   AGENT_TOKEN=ah_...             issued once, on the account page
#   AGENT_BRAIN=heuristic|model    heuristic needs no key at all
#   AGENT_STRATEGY="..."           only read by the model brain
#   GEMINI_API_KEYS, GEMINI_MODEL, AGENT_RATE_LIMIT_RPM, AGENT_MAX_OUTPUT_TOKENS
#   AGENT_FIELD=field.json         to run several agents from one process

# --- ERC-8004 ---------------------------------------------------------------
# Publishing records to the Trustless Agents registries. Attestations are posted
# by `pnpm attest`, never by the running server, so this key is not loaded by
# the app and is separate from TREASURY_PRIVATE_KEY on purpose.
#
# The three registries are per-chain singletons somebody else deployed. Name
# them after the chain's own key, the same way vaults are named:
#   MONAD_TESTNET_IDENTITY_REGISTRY=0x...
#   MONAD_TESTNET_REPUTATION_REGISTRY=0x...
#   MONAD_TESTNET_VALIDATION_REGISTRY=0x...
ATTESTOR_PRIVATE_KEY=

# Where a reader can fetch an attestation. Goes on chain as the evidence URI, so
# it has to be reachable from outside, not localhost.
PUBLIC_BASE_URL=
