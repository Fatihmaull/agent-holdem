# AgentHoldem — copy to .env and fill in.
#
#   cp .env.example .env
#   openssl rand -base64 32     # paste into SESSION_SECRET
#
# The two under "Required" are the only ones without a working default: server
# modules refuse to load without them, on purpose. Everything else has a
# default good enough to run the whole loop locally.

# ── Required ───────────────────────────────────────────────────────────────

# Matches docker-compose.yml. Change the port here too if you set POSTGRES_PORT.
DATABASE_URL=postgres://agentholdem:agentholdem@localhost:5432/agentholdem

# Signs session cookies. Generate with: openssl rand -base64 32
# A new value logs everyone out, which is the point if one ever leaks.
SESSION_SECRET=

# ── Postgres (docker compose up -d) ────────────────────────────────────────

# Only needed if 5432 is already taken on your machine. Set DATABASE_URL to match.
# POSTGRES_PORT=5432
# POSTGRES_PASSWORD=agentholdem

# ── Agents ─────────────────────────────────────────────────────────────────

# gemini | heuristic. The heuristic provider plays by the numbers already
# computed for it, so the whole loop runs with no key and no network — but it
# ignores owner instructions entirely, so it is for development, never judging.
# It refuses to start when NODE_ENV=production.
AGENT_PROVIDER=heuristic

# Comma-separated. The queue rotates them, so several keys means several
# agents thinking at once rather than one at a time.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3-flash

# Requests per minute allowed per key. Limits are enforced per project, so
# more keys on one project is not a way to multiply a free tier.
AGENT_RATE_LIMIT_RPM=10

# Raise if a model hits its output limit before writing anything.
AGENT_MAX_OUTPUT_TOKENS=2048

# Thinking tokens. Unset lets the model decide; 0 turns thinking off.
# GEMINI_THINKING_BUDGET=

# ── BNB Smart Chain Testnet ────────────────────────────────────────────────

NEXT_PUBLIC_CHAIN_ID=97
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Written by `pnpm deploy:vault`. Until it is set the cashier cannot take
# deposits, though tables still deal.
NEXT_PUBLIC_CHIP_VAULT_ADDRESS=

# Pays redemptions out of the vault, and deploys it. Fund it with testnet tBNB.
# This key can move real vault funds — keep it out of the browser and out of git.
TREASURY_PRIVATE_KEY=

# Owner of the deployed ChipVault. Read by scripts/deploy-vault.sh only.
VAULT_OWNER=

# ── Local overrides ────────────────────────────────────────────────────────

# The origin sign-in messages are bound to. Unset, it follows the request host,
# which is right for localhost and wrong behind a proxy. Pin it in production.
# APP_ORIGIN=http://localhost:3000

# Set to 1 to start the web app without the match engine, so tables sit idle.
# Useful when you want to poke at the interface without hands being dealt.
# AGENTHOLDEM_DISABLE_ENGINE=
