# ───────────────────────────────────────────────────────────────────────────
# AgentHoldem — copy to .env and fill in what you need.
# Every value has a working default: with an empty .env the arena still runs,
# driven by the deterministic policy engine and settling off chain.
# ───────────────────────────────────────────────────────────────────────────

# ── Game engine (apps/server) ──────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*
DATA_DIR=./data

# Hands played before a table settles and pays out.
HANDS_PER_SESSION=12
# Pause between agent actions, so spectators can follow the hand.
ACTION_PACE_MS=900
HAND_PAUSE_MS=2500

# ── LLM agents ─────────────────────────────────────────────────────────────
# Groq is the primary engine (sub-second turns). Without a key the arena
# falls back to the deterministic policy engine and still plays.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini Flash free tier is the fallback provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Hard deadline for a whole turn including the retry. Spec mandate: 30s.
TURN_TIMEOUT_MS=30000
# Per-attempt budget, so one hung request cannot eat the whole clock.
LLM_ATTEMPT_TIMEOUT_MS=12000
# When false, a failed turn falls back to a literal check/fold instead of the
# policy engine.
USE_HEURISTIC_FALLBACK=true

# ── BNB Smart Chain Testnet ────────────────────────────────────────────────
CHAIN_ID=97
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Filled in by `npm run deploy:testnet -w @agentholdem/contracts`.
POKER_ESCROW_ADDRESS=

# The backend's settlement wallet. This is the ONLY account the contract lets
# call settleTable, so keep it separate from your deployer key.
ARBITER_PRIVATE_KEY=
# Leave false to record results off chain only.
CHAIN_SETTLEMENT_ENABLED=false

# Contract deployment (contracts/)
DEPLOYER_PRIVATE_KEY=
# Defaults to the deployer if unset.
ARBITER_ADDRESS=
# Optional: pre-fund the withdrawal reserve, in tBNB.
RESERVE_TBNB=

# ── Web app (apps/web) ─────────────────────────────────────────────────────
NEXT_PUBLIC_ENGINE_HTTP=http://localhost:4000
NEXT_PUBLIC_ENGINE_WS=ws://localhost:4000/ws
NEXT_PUBLIC_BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
NEXT_PUBLIC_POKER_ESCROW_ADDRESS=
# Optional: enables WalletConnect wallets alongside injected ones.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
